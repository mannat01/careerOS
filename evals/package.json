{
  "name": "@careeros/evals",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsc --noEmit",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "eval": "vitest run --config vitest.eval.config.ts",
    "eval:ci": "vitest run --config vitest.eval-ci.config.ts",
    "eval:real": "vitest run --config vitest.real.config.ts --reporter=verbose",
    "eval:real:tailoring": "vitest run --config vitest.real.config.ts real/tailoring.real.ts --reporter=verbose",
    "eval:real:scoring": "vitest run --config vitest.real.config.ts real/scoring.real.ts --reporter=verbose",
    "eval:real:decision": "vitest run --config vitest.real.config.ts real/decision.real.ts --reporter=verbose",
    "eval:real:planner": "vitest run --config vitest.real.config.ts real/planner.real.ts --reporter=verbose",
    "eval:real:research": "vitest run --config vitest.real.config.ts real/research.real.ts --reporter=verbose",
    "eval:real:interview": "vitest run --config vitest.real.config.ts real/interview.real.ts --reporter=verbose"
  },
  "dependencies": {
    "@careeros/agents": "workspace:*",
    "@careeros/cie-drafting": "workspace:*",
    "@careeros/cie-interview": "workspace:*",
    "@careeros/cie-metrics": "workspace:*",
    "@careeros/cie-planner": "workspace:*",
    "@careeros/cie-reasoning": "workspace:*",
    "@careeros/cie-research": "workspace:*",
    "@careeros/cie-resume": "workspace:*",
    "@careeros/cie-state": "workspace:*",
    "@careeros/connectors": "workspace:*",
    "@careeros/llm-gateway": "workspace:*"
  },

  "devDependencies": {
    "@careeros/config": "workspace:*"
  }
}
